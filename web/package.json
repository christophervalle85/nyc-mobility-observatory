{
  "name": "nyc-mobility-observatory-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:verify": "MOBILITY_AUTOMATION=1 VITE_CESIUM_ION_TOKEN= vite --mode verify --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "MOBILITY_AUTOMATION=1 VITE_CESIUM_ION_TOKEN= vite build --mode verify",
    "preview": "MOBILITY_AUTOMATION=1 VITE_CESIUM_ION_TOKEN= vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "VITE_CESIUM_ION_TOKEN= node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "test:e2e": "MOBILITY_AUTOMATION=1 VITE_CESIUM_ION_TOKEN= playwright test",
    "dev:live": "vite --mode live --host 127.0.0.1 --port 5173 --strictPort"
  },
  "dependencies": {
    "cesium": "1.147.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
